# ---- required
BASE_URL=https://yourcve.example.com
DOMAIN=yourcve.example.com            # only for the Caddy profile (tls)
SECRET_KEY=                           # openssl rand -hex 32  (never change it: encrypts channel secrets)
POSTGRES_PASSWORD=                    # openssl rand -hex 24
ADMIN_EMAILS=you@example.com          # these accounts get the admin dashboard

# ---- email (magic links, email channel). Empty: login links are written to the log
SMTP_URL=smtp://user:password@mail.example.com:587
SMTP_FROM=yourcve <noreply@yourcve.example.com>

# ---- data sources (recommended)
NVD_API_KEY=                          # https://nvd.nist.gov/developers/request-an-api-key (10x faster)
GITHUB_TOKEN=                         # only used once for the initial cvelistV5 archive lookup
INITIAL_IMPORT=true                   # full CVE history on first start (takes 30-90 min)

# ---- local AI (optional): docker compose --profile ai up -d
# OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text

# ---- backups with WAL-G (optional, empty = disabled)
WALG_S3_PREFIX=                       # s3://bucket/yourcve
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
AWS_ENDPOINT=                         # e.g. https://fsn1.your-objectstorage.com
AWS_S3_FORCE_PATH_STYLE=false
BACKUP_RETAIN_FULL=7

# ---- Anubis
ANUBIS_PORT=8923
ANUBIS_USE_REMOTE_ADDRESS=false       # true if nothing sits in front of Anubis
ANUBIS_PRIVATE_KEY_HEX=               # openssl rand -hex 32

# ---- later with Plus
SEVEN_API_KEY=
STRIPE_SECRET_KEY=
